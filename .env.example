# ─── Site ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://game-discount-nine.vercel.app
STEAM_COUNTRY_CODE=us

# ─── Affiliate Programs (sign up → paste your IDs) ─────────────
# CheapShark tag (register at cheapshark.com for a tag)
NEXT_PUBLIC_CHEAPSHARK_TAG=

# Fanatical — up to 5% commission, 30-day cookie
# Sign up: https://www.fanatical.com/en/affiliate
NEXT_PUBLIC_FANATICAL_AFFILIATE_ID=

# GOG — ~5% commission, 30-day cookie
# Sign up: https://www.gog.com/affiliate
NEXT_PUBLIC_GOG_AFFILIATE_ID=

# Humble Store — 5-10% commission, 30-day cookie
# Sign up: https://www.humblebundle.com/partner
NEXT_PUBLIC_HUMBLE_PARTNER_ID=

# Green Man Gaming — up to 5% commission, 30-day cookie
# Sign up: https://www.greenmangaming.com/affiliates/
NEXT_PUBLIC_GMG_AFFILIATE_ID=

# GamersGate — ~5% commission, 30-day cookie
NEXT_PUBLIC_GAMERSGATE_AFFILIATE_ID=

# ─── Ads ───────────────────────────────────────────────────────
# Google AdSense publisher ID — accepts "pub-xxx" or "ca-pub-xxx"
# With just this set, AdSense Auto Ads will fill placements automatically.
NEXT_PUBLIC_ADSENSE_PUB_ID=pub-3315807953502049

# Optional: manual ad unit slot IDs from AdSense dashboard.
# Create ad units at https://www.google.com/adsense → Ads → By ad unit
# If not set, Auto Ads handles placement automatically.
NEXT_PUBLIC_AD_SLOT_BANNER_TOP=
NEXT_PUBLIC_AD_SLOT_SIDEBAR=
NEXT_PUBLIC_AD_SLOT_IN_FEED=
NEXT_PUBLIC_AD_SLOT_BANNER_BOTTOM=

# ─── Database (Neon / Vercel Postgres) ────────────────────────
# Create at https://neon.tech or add Neon integration in Vercel dashboard
POSTGRES_URL=

# ─── Auth ─────────────────────────────────────────────────────
# Random 256-bit secret for signing JWT sessions
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ─── Email (Resend) ──────────────────────────────────────────
# Sign up at https://resend.com — free tier: 3,000 emails/month
RESEND_API_KEY=
RESEND_FROM_EMAIL=Steam Deals Hub <alerts@steam-deals-hub.coupons>

# ─── Cron Security ───────────────────────────────────────────
# Vercel automatically sets this for cron jobs.
# For manual testing: set any secret string.
CRON_SECRET=
